{
	"name": "svelte-chess",
	"description": "3D Chess Game with Dual Chess Clock, Multi-Level AI, and Grand Coach built with Svelte 5 and Three.js",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/timscodebase/svelte-chess.git"
	},
	"bugs": {
		"url": "https://github.com/timscodebase/svelte-chess/issues"
	},
	"homepage": "https://github.com/timscodebase/svelte-chess#readme",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/three": "^0.185.4",
		"@vitest/browser-playwright": "catalog:",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.1",
		"vite-plus": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.40.0",
		"three": "^0.185.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.25.0",
			"onFail": "download"
		}
	}
}
